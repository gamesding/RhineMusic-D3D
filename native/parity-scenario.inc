            check("paused Sony animation preserves its phase",.5,[phases](auto& r){int found=0;for(auto& b:r.at("ui").at("audioBadges")){auto key=b.at("name").template get<std::string>();if(phases->contains(key)){if(std::abs(b.at("phase").template get<double>()-(*phases)[key].template get<double>())>1e-6)return false;++found;}}return found==3;});capture("sony-paused");
