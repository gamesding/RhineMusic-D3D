            action("change album to exercise metadata reels",.05,"navigate",{{"row",1}});
            check("metadata glyphs roll during selection",.12,[](auto& r){int moving=0;for(auto& item:r.at("ui").at("metadataMotion").items())moving+=item.value().value("movingGlyphs",0);return moving>0;});capture("metadata-motion");
            action("interrupt album glyph motion",.05,"navigate",{{"row",-1}});
